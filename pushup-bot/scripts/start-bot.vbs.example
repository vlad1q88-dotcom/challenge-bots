' Запуск бота без окна терминала.
' 1. Скопируй этот файл в папку бота как start-bot.vbs
' 2. Замени путь в строке ниже на свой
' 3. Пропиши его в Планировщике заданий (см. docs/deploy.md, раздел 7а)

folder = "C:\Users\ИМЯ\Documents\challenge-bots\pushup-bot"

Set shell = CreateObject("WScript.Shell")
shell.CurrentDirectory = folder
' Вывод пишем в bot.log — туда же попадут ошибки, если бот не поднимется.
shell.Run "cmd /c npm start >> """ & folder & "\bot.log"" 2>&1", 0, False
